  "dependencies": { "vue": "3.5.44" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
